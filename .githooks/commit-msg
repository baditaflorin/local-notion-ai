#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file required}"
first_line="$(head -n 1 "$message_file")"

if [[ ! "$first_line" =~ ^(feat|fix|docs|chore|refactor|test|ops|data|build|style|perf)(\([a-zA-Z0-9_-]+\))?!?:\ .+ ]]; then
  echo "Commit message must use Conventional Commits, got: $first_line" >&2
  exit 1
fi

